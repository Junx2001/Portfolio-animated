---
interface Experience {
  company: string;
  role: string;
  start: string; // YYYY-MM
  end: string; // YYYY-MM or "Present"
  location: string;
  type: string; // Full-time, Contract, etc.
  summary?: string;
  impacts: string[];
  tools: string[];
  stack: string[];
  link?: string;
}

const monthDiff = (start: string, end: string) => {
  const [sy, sm] = start.split("-").map(Number);
  const endDate = end === "Present" ? new Date() : new Date(Number(end.split("-")[0]), Number(end.split("-")[1]) - 1, 1);
  const startDate = new Date(sy, sm - 1, 1);
  let months = (endDate.getFullYear() - startDate.getFullYear()) * 12;
  months += endDate.getMonth() - startDate.getMonth();
  if (months < 0) months = 0;
  const years = Math.floor(months / 12);
  const remMonths = months % 12;
  const parts: string[] = [];
  if (years > 0) parts.push(`${years} yr${years > 1 ? "s" : ""}`);
  if (remMonths > 0) parts.push(`${remMonths} mo${remMonths > 1 ? "s" : ""}`);
  return parts.join(" ") || "< 1 mo";
};

const formatRange = (start: string, end: string) => {
  const [sy, sm] = start.split("-").map(Number);
  const startLabel = new Date(sy, sm - 1, 1).toLocaleString("en-US", { month: "short", year: "numeric" });
  const endLabel = end === "Present" ? "Present" : new Date(Number(end.split("-")[0]), Number(end.split("-")[1]) - 1, 1).toLocaleString("en-US", { month: "short", year: "numeric" });
  return `${startLabel} — ${endLabel}`;
};

const experiences: Experience[] = [
  {
    company: "Fintech Platform Co.",
    role: "Senior Software Engineer",
    start: "2023-01",
    end: "Present",
    location: "Remote · Europe",
    type: "Full-time",
    summary: "Led architecture and platform engineering for a cloud-native payments system focused on scale, reliability, and developer velocity.",
    impacts: [
      "Designed a modular monolith evolving to microservices with DDD; cut cross-team coupling and improved lead time by 35%.",
      "Introduced event-driven patterns (outbox, Sagas) to ensure exactly-once semantics across services.",
      "Improved SLOs to 99.95% and reduced P99 latencies by 28% via async processing and caching.",
      "Reduced infra cost by ~18% through autoscaling, right-sizing, and storage optimizations.",
      "Built golden-path templates, ADRs and runbooks to standardize delivery across teams.",
    ],
    tools: ["AWS", "Kubernetes", "Terraform", "Grafana", "Prometheus", "Loki", "GitHub Actions"],
    stack: ["Node.js", "NestJS", "PostgreSQL", "Kafka", "Redis", "React", "Astro", "OpenAPI"],
    link: "#",
  },
  {
    company: "E‑commerce Marketplace",
    role: "Software Engineer",
    start: "2021-03",
    end: "2022-12",
    location: "Paris, FR",
    type: "Full-time",
    summary: "Built core web experiences and APIs powering catalog, search, and checkout with a performance-first mindset.",
    impacts: [
      "Re-architected SSR/SSG flow to improve LCP by ~30% and TTFB by ~20% across key pages.",
      "Implemented API versioning and contract tests; reduced integration regressions by 60%.",
      "Set up GitLab CI pipelines with caching and parallelization; cut CI time from 18m to 10m.",
      "Instrumented tracing and business metrics for funnel analytics and SLA adherence.",
    ],
    tools: ["GCP", "Cloud Run", "GitLab CI", "Datadog", "BigQuery", "Snyk"],
    stack: ["Express", "Next.js", "TypeScript", "Redis", "Pub/Sub", "OpenAPI"],
  },
  {
    company: "SaaS Analytics",
    role: "Full‑Stack Engineer",
    start: "2019-08",
    end: "2021-02",
    location: "Antananarivo, MG",
    type: "Full-time",
    summary: "Delivered end-to-end features across web UI, APIs, and infrastructure for a multi-tenant analytics product.",
    impacts: [
      "Shipped role-based access control and audit trails; hardened security posture.",
      "Containerized monolith and migrated to Dockerized workloads; enabled safe blue/green releases.",
      "Introduced automated testing and lint/type checks; lifted coverage from 35% to 72%.",
    ],
    tools: ["Docker", "Jenkins", "Nginx", "Grafana"],
    stack: ["FastAPI", "React", "PostgreSQL", "SQLAlchemy", "TailwindCSS"],
  },
];

const computed = experiences.map((e) => ({
  ...e,
  duration: monthDiff(e.start, e.end),
  range: formatRange(e.start, e.end),
}));
---

<section id="experience" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Experiences</h3>

    <div class="space-y-6">
      {computed.map((item, idx) => (
        <article class="relative group bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl overflow-hidden">
          <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-[var(--sec)]/60 to-transparent opacity-70"></div>

          <div class="p-5 md:p-6">
            <header class="flex flex-col md:flex-row md:items-start gap-3 md:gap-4">
              <div class="flex items-center gap-3 min-w-0">
                <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-white/5 border border-[var(--white-icon-tr)] grid place-items-center text-[var(--sec)]">
                  <!-- briefcase icon -->
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                    <path d="M9 3h6a2 2 0 0 1 2 2v1h3a1 1 0 0 1 1 1v4h-3v-2H6v2H3V7a1 1 0 0 1 1-1h3V5a2 2 0 0 1 2-2zm6 3V5H9v1h6z"></path>
                    <path d="M3 11h3v2h12v-2h3v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6z"></path>
                  </svg>
                </div>
                <div class="min-w-0">
                  <h4 class="text-xl md:text-2xl font-semibold truncate">{item.role} <span class="text-[var(--white-icon)] font-normal">@ {item.company}</span></h4>
                  <div class="flex flex-wrap items-center gap-2 text-[12px] text-[var(--white-icon)] mt-1">
                    <div class="px-2 py-1 rounded-full border border-[var(--white-icon-tr)] bg-white/5">
                      {item.range}
                    </div>
                    <div class="px-2 py-1 rounded-full border border-[var(--white-icon-tr)] bg-white/5">
                      {item.duration}
                    </div>
                    <div class="px-2 py-1 rounded-full border border-[var(--white-icon-tr)] bg-white/5">
                      {item.location}
                    </div>
                    <div class="px-2 py-1 rounded-full border border-[var(--white-icon-tr)] bg-white/5">
                      {item.type}
                    </div>
                  </div>
                </div>
              </div>

              {item.link && (
                <a href={item.link} target="_blank" rel="noopener" class="ml-auto md:ml-0 inline-flex items-center gap-2 text-[var(--white)] text-sm hover:text-white/90 border border-[var(--white-icon-tr)] bg-white/5 hover:bg-white/10 px-3 py-1.5 rounded-lg transition-colors">
                  <span>Company</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                  </svg>
                </a>
              )}
            </header>

            {item.summary && (
              <p class="text-[var(--white-icon)] text-sm md:text-[15px] mt-3">
                {item.summary}
              </p>
            )}

            <div class="mt-4 grid md:grid-cols-2 gap-4">
              <div>
                <div class="text-[12px] uppercase tracking-wide text-[var(--white-icon)]/80 mb-2">Impact</div>
                <ul class="space-y-2 text-[var(--white-icon)] text-[13px] md:text-[14px]">
                  {item.impacts.map((i) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-[3px] text-[var(--sec)]">●</span>
                      <span>{i}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <div class="text-[12px] uppercase tracking-wide text-[var(--white-icon)]/80 mb-2">Tools & Stack</div>
                <div class="flex flex-wrap gap-2">
                  {item.tools.map((t) => (
                    <span class="px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[12px] text-[var(--white)] bg-white/5">{t}</span>
                  ))}
                </div>
                <div class="flex flex-wrap gap-2 mt-2">
                  {item.stack.map((s) => (
                    <span class="px-2.5 py-1 rounded-full border border-[var(--white-icon-tr)] text-[12px] text-[var(--white)] bg-white/5">{s}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
